---
/**
 * Thin inline stroke icons (1.4px, currentColor). Decorative: pair with a visible
 * label or an aria-label on the parent link/button.
 */
interface Props {
  name: 'phone' | 'instagram' | 'arrow' | 'menu' | 'close';
  size?: number;
}
const { name, size = 20 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  aria-hidden="true"
  focusable="false"
>
  {name === 'phone' && (
    <path d="M6.6 3.5h2.8l1.4 4-2 1.3a11 11 0 0 0 6.4 6.4l1.3-2 4 1.4v2.8a1.6 1.6 0 0 1-1.7 1.6A16.5 16.5 0 0 1 5 5.2a1.6 1.6 0 0 1 1.6-1.7z" />
  )}
  {name === 'instagram' && (
    <>
      <rect x="4" y="4" width="16" height="16" rx="4.5" />
      <circle cx="12" cy="12" r="3.6" />
      <circle cx="16.9" cy="7.1" r="0.7" />
    </>
  )}
  {name === 'arrow' && (
    <>
      <path d="M4 12h15" />
      <path d="M14 7l5 5-5 5" />
    </>
  )}
  {name === 'menu' && (
    <>
      <path d="M3 7h18" />
      <path d="M3 12h18" />
      <path d="M3 17h18" />
    </>
  )}
  {name === 'close' && (
    <>
      <path d="M5 5l14 14" />
      <path d="M19 5L5 19" />
    </>
  )}
</svg>
