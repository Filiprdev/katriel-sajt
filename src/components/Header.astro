---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import OrderButtons from './OrderButtons.astro';
import LangSwitch from './LangSwitch.astro';
import logoBlack from '../assets/brand/logo-black.png';
import logoIvory from '../assets/brand/logo-ivory.png';
import { site, telHref, mainNavCategories } from '../../config/site';
import { useI18n } from '../i18n';
import { categoryName } from '../lib/catalog';

interface Props {
  /** Transparent header over a dark hero (home page). */
  overlay?: boolean;
  /** Category slug of the current page, highlights the matching nav link. */
  current?: string;
}

const { overlay = false, current } = Astro.props;
const { t, l, lang, path } = useI18n(Astro);
const logo = overlay ? logoIvory : logoBlack;
const logoHeight = overlay ? 60 : 54;

const categories = await getCollection('categories');
const nav = mainNavCategories
  .map((id) => categories.find((c) => c.id === id))
  .filter((c) => c !== undefined)
  .map((c) => ({ id: c.id, label: categoryName(c, lang), href: l(`/shop/${c.id}/`) }));
const extra = [
  { label: t.nav.fashionShow, href: l('/fashion-show/'), current: path === '/fashion-show/' },
  { label: t.nav.celebrities, href: l('/celebrities/'), current: path === '/celebrities/' },
  { label: t.nav.collections, href: l('/collections/'), current: path.startsWith('/collections/') },
];
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]} data-header>
  <div class="site-header__inner">
    <button
      type="button"
      class="icon-btn site-header__toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-open
    >
      <Icon name="menu" />
      <span class="visually-hidden">{t.common.menu}</span>
    </button>

    <nav class="site-header__nav" aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} aria-current={item.id === current ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <a href={l('/')} class="site-header__logo" aria-label={t.common.homeAria}>
      <Image src={logo} alt="" height={logoHeight} densities={[1, 2]} loading="eager" fetchpriority="high" />
    </a>

    <div class="site-header__actions">
      {extra.map((item) => (
        <a href={item.href} class="site-header__text-link" aria-current={item.current ? 'page' : undefined}>{item.label}</a>
      ))}
      <LangSwitch class="site-header__lang" />
      <a href={telHref} class="icon-btn" aria-label={t.common.callAria}>
        <Icon name="phone" />
      </a>
      <a href={site.instagram.url} class="icon-btn" aria-label={t.common.instagramAria} rel="noopener" target="_blank">
        <Icon name="instagram" />
      </a>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden data-menu>
    <div class="mobile-menu__top">
      <button type="button" class="icon-btn" data-menu-close>
        <Icon name="close" />
        <span class="visually-hidden">{t.common.closeMenu}</span>
      </button>
      <LangSwitch />
    </div>
    <nav aria-label="Mobile">
      <ul role="list" class="mobile-menu__list">
        {nav.map((item) => (
          <li><a href={item.href} aria-current={item.id === current ? 'page' : undefined}>{item.label}</a></li>
        ))}
        {extra.map((item) => (
          <li><a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="mobile-menu__order">
      <p class="eyebrow">{t.order.orderYourPiece}</p>
      <OrderButtons />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    color: var(--ink);
    border-bottom: 1px solid var(--sand-2);
  }
  .site-header--overlay {
    position: absolute;
    left: 0;
    right: 0;
    color: var(--ivory);
    border-bottom: 0;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    padding: 24px var(--gutter);
  }
  .site-header--overlay .site-header__inner {
    padding-block: 26px;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
  }
  .site-header__nav a,
  .site-header__text-link {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding-block: 4px;
    border-bottom: 1px solid transparent;
    white-space: nowrap;
  }
  .site-header__nav a[aria-current='page'],
  .site-header__text-link[aria-current='page'] {
    border-bottom-color: currentColor;
  }

  .site-header__logo {
    display: block;
    justify-self: center;
  }
  .site-header__logo img {
    width: auto;
    height: 54px;
  }
  .site-header--overlay .site-header__logo img {
    height: 60px;
  }

  .site-header__actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 4px;
  }
  .site-header__text-link {
    margin-right: 18px;
  }
  .site-header__actions :global(.site-header__lang) {
    margin-right: 6px;
  }

  .site-header__toggle {
    display: none;
  }

  /* ---------- Menu button below 1200px (nav needs the room) ---------- */
  @media (max-width: 1199px) {
    .site-header__inner {
      padding-block: 16px;
    }
    .site-header--overlay .site-header__inner {
      padding-block: 18px;
    }
    .site-header__toggle {
      display: inline-flex;
      justify-self: start;
      margin-left: -10px;
    }
    .site-header__nav,
    .site-header__text-link {
      display: none;
    }
    .site-header__actions {
      margin-right: -10px;
      gap: 0;
    }
    .site-header__logo img,
    .site-header--overlay .site-header__logo img {
      height: 42px;
    }
  }
  @media (max-width: 479px) {
    /* Phone: language switch lives in the menu panel */
    .site-header__actions :global(.site-header__lang) {
      display: none;
    }
  }

  /* ---------- Mobile menu panel ---------- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 40px;
    overflow-y: auto;
    padding: 16px var(--gutter) 40px;
    background: var(--ivory);
    color: var(--ink);
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-left: -10px;
  }
  .mobile-menu__list {
    display: flex;
    flex-direction: column;
  }
  .mobile-menu__list a {
    display: flex;
    align-items: center;
    min-height: 56px;
    border-bottom: 1px solid var(--sand-2);
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 34px;
    line-height: 1.2;
  }
  .mobile-menu__list a[aria-current='page'] {
    font-style: italic;
  }
  .mobile-menu__order {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: auto;
  }

  @media (min-width: 1200px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menu = header?.querySelector<HTMLElement>('[data-menu]');
  const openBtn = header?.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = header?.querySelector<HTMLButtonElement>('[data-menu-close]');

  if (header && menu && openBtn && closeBtn) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      openBtn.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      (open ? closeBtn : openBtn).focus();
    };

    openBtn.addEventListener('click', () => setOpen(true));
    closeBtn.addEventListener('click', () => setOpen(false));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) setOpen(false);
    });

    window.matchMedia('(min-width: 1200px)').addEventListener('change', (e) => {
      if (e.matches && !menu.hidden) setOpen(false);
    });
  }
</script>
