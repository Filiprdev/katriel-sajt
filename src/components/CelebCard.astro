---
/**
 * One celebrity: 3:4 photo, name, category. With several photos, small thumbnails swap
 * the main photo (vanilla script below). With a video, a link jumps to it on /celebrities/.
 */
import { getImage } from 'astro:assets';
import type { Celebrity } from '../data/celebrities';
import { useI18n } from '../i18n';

interface Props {
  person: Celebrity;
  /** Show thumbnails and the video link (celebrities page). */
  full?: boolean;
  /** Heading level for the name. */
  as?: 'h3' | 'p';
  sizes?: string;
}

const { person, full = false, as: Tag = 'h3', sizes = '(min-width: 1024px) 25vw, 50vw' } = Astro.props;
const { t, l } = useI18n(Astro);
const c = t.celebs;
const name = person.name ?? c.unnamed;
const role = c.one[person.category];

const widths = [360, 540, 720, 1000];
const photos = await Promise.all(
  (full ? person.photos : person.photos.slice(0, 1)).map(async (src) => {
    const [main, thumb] = await Promise.all([
      getImage({ src, widths: widths.filter((w) => w <= src.width), format: 'webp' }),
      getImage({ src, width: 120, height: 160, fit: 'cover', format: 'webp' }),
    ]);
    return { main, thumb };
  }),
);
const first = photos[0].main;
---

<article class="celeb" data-celeb>
  <div class="celeb__media">
    <img
      src={first.src}
      srcset={first.srcSet.attribute}
      sizes={sizes}
      width={first.attributes.width}
      height={first.attributes.height}
      alt={c.photoOf(name, 1)}
      loading="lazy"
      decoding="async"
      data-celeb-main
    />
  </div>
  {photos.length > 1 && (
    <div class="celeb__thumbs">
      {photos.map((p, i) => (
        <button
          type="button"
          class="celeb__thumb"
          aria-pressed={i === 0 ? 'true' : 'false'}
          aria-label={c.showPhoto(i + 1)}
          data-src={p.main.src}
          data-srcset={p.main.srcSet.attribute}
          data-alt={c.photoOf(name, i + 1)}
        >
          <img src={p.thumb.src} alt="" width="40" height="53" loading="lazy" decoding="async" />
        </button>
      ))}
    </div>
  )}
  <div class="celeb__text">
    <Tag class="celeb__name">{name}</Tag>
    {role && <p class="celeb__role">{role}</p>}
    {full && person.videos.length > 0 && (
      <a class="celeb__video" href={`${l('/celebrities/')}#video-${person.id}`}>{c.watchVideo}</a>
    )}
  </div>
</article>

<style>
  .celeb {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .celeb__media {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--stone);
  }
  .celeb__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
  }
  .celeb__thumbs {
    display: flex;
    gap: 6px;
  }
  .celeb__thumb {
    display: block;
    width: 44px;
    height: 58px;
    padding: 0;
    border: 1px solid transparent;
    background: var(--stone);
    opacity: 0.6;
    cursor: pointer;
  }
  .celeb__thumb[aria-pressed='true'] {
    border-color: var(--ink);
    opacity: 1;
  }
  .celeb__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .celeb__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .celeb__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 24px;
    line-height: 1.2;
  }
  .celeb__role {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .celeb__video {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }
  @media (max-width: 767px) {
    .celeb__name {
      font-size: 20px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-celeb]').forEach((card) => {
    const main = card.querySelector<HTMLImageElement>('[data-celeb-main]');
    const thumbs = Array.from(card.querySelectorAll<HTMLButtonElement>('.celeb__thumb'));
    thumbs.forEach((btn) =>
      btn.addEventListener('click', () => {
        if (!main) return;
        main.srcset = btn.dataset.srcset ?? '';
        main.src = btn.dataset.src ?? main.src;
        main.alt = btn.dataset.alt ?? main.alt;
        thumbs.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      }),
    );
  });
</script>
