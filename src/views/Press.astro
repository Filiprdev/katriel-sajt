---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PressFeature from '../components/PressFeature.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import CelebritiesStrip from '../components/CelebritiesStrip.astro';
import Photo from '../components/Photo.astro';
import voguePage from '../assets/press/vogue-page.jpg';
import vogueDetail from '../assets/press/vogue-detail.jpg';
import InterviewCard from '../components/InterviewCard.astro';
import { interviews } from '../data/interviews';
import { site } from '../../config/site';
import { useI18n, intlLocale } from '../i18n';

const { t, l, lang } = useI18n(Astro);
const p = t.press;
const v = p.vogue;
const shooter = site.press.photographer;
const FIRST = 6; // interviews visible before "Show all"
const formatDate = (iso: string) =>
  new Intl.DateTimeFormat(intlLocale[lang], { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso));
---

<BaseLayout title={p.pageTitle} description={p.pageDescription}>
  <div class="container press-page">
    <PageHeader title={p.pageTitle} intro={p.pageIntro} breadcrumb={[{ label: t.common.home, href: l('/') }, { label: p.pageTitle }]} />

    <div class="press-page__feature">
      <PressFeature />
    </div>

    <article class="press-page__block vogue" id="vogue-article" aria-labelledby="vogue-article-title">
      <div class="vogue__text">
        <p class="eyebrow">{v.eyebrow}</p>
        <h2 id="vogue-article-title" class="vogue__title">{v.title}</h2>
        <p class="vogue__lead">{v.lead}</p>
        <h3 class="vogue__sub">{v.keyTitle}</h3>
        <ul role="list" class="vogue__points">
          {v.points.map((point) => <li>{point}</li>)}
        </ul>
        <blockquote class="vogue__quote">
          <p lang="en">“{v.quote}”</p>
          <footer>{v.quoteSource}</footer>
        </blockquote>
        <h3 class="vogue__sub">{v.creditsTitle}</h3>
        <dl class="vogue__credits">
          <div><dt>{v.jewelry}</dt><dd>Katriel</dd></div>
          <div>
            <dt>{v.photo}</dt>
            <dd>
              <a href={shooter.href} rel="noopener" target="_blank">{shooter.name}</a> ·
              <a href={`https://www.instagram.com/${shooter.instagram}/`} rel="noopener" target="_blank">@{shooter.instagram}</a>
            </dd>
          </div>
        </dl>
      </div>
      <figure class="vogue__print">
        <figcaption class="vogue__sub">{v.printTitle}</figcaption>
        <div class="vogue__pages">
          <Photo src={voguePage} alt={v.pageAlt} ratio="4/5" sizes="(min-width: 1024px) 24vw, 50vw" widths={[360, 540, 720, 1080]} />
          <Photo src={vogueDetail} alt={v.detailAlt} ratio="4/5" sizes="(min-width: 1024px) 24vw, 50vw" widths={[360, 540, 720, 1080]} />
        </div>
      </figure>
    </article>

    <section class="press-page__block" aria-labelledby="articles-title">
      <h2 id="articles-title" class="press-page__title">{p.articlesTitle}</h2>
      <ul role="list" class="articles">
        {site.articles.map((a) => (
          <li class="article">
            <p class="article__meta">
              {a.publication} · <time datetime={a.date}>{formatDate(a.date)}</time> · {a.author}
            </p>
            <h3 class="article__title" lang="sr">„{a.title}”</h3>
            <p class="article__summary">{p.articleSummary}</p>
            <a class="link-more" href={a.href} rel="noopener" target="_blank">{p.readArticle}<Icon name="arrow" size={18} /></a>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <section class="section section--stone interviews" aria-labelledby="interviews-title">
    <div class="container">
      <SectionHeading eyebrow={p.tvEyebrow} title={p.tvTitle} id="interviews-title" />
      <p class="interviews__intro">{p.tvIntro}</p>
      <ul role="list" class="interviews__grid" data-interviews>
        {interviews.map((item, i) => (
          <li data-extra={i >= FIRST ? "" : undefined}><InterviewCard item={item} /></li>
        ))}
      </ul>
      {interviews.length > FIRST && (
        <div class="interviews__more" hidden>
          <button type="button" class="btn btn--outline" data-interviews-more>{p.showAll(interviews.length)}</button>
        </div>
      )}
    </div>
  </section>

  <CelebritiesStrip id="worn-title" />

  <div class="container press-page">
    <section class="press-page__block press-page__contact" aria-labelledby="enquiries-title">
      <h2 id="enquiries-title" class="press-page__title">{p.enquiriesTitle}</h2>
      <p>{p.enquiriesText} <a href={`mailto:${site.pressEmail}`}>{site.pressEmail}</a>.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .press-page {
    padding-bottom: var(--section-y);
  }
  .press-page__feature {
    padding-block: 48px var(--section-y);
    border-top: 1px solid var(--sand-2);
  }
  .press-page__block {
    padding-top: 48px;
    border-top: 1px solid var(--sand-2);
  }
  .press-page__title {
    margin-bottom: 28px;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(32px, 3vw, 40px);
    line-height: 1.1;
  }
  .press-page__contact p {
    font-size: 17px;
    color: var(--text-2);
  }
  .press-page__contact a {
    color: var(--ink);
    border-bottom: 1px solid currentColor;
  }

  .vogue {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 104px);
    align-items: start;
    margin-bottom: var(--section-y);
    scroll-margin-top: 96px;
  }
  .vogue__title {
    margin-top: 14px;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(34px, 3.4vw, 48px);
    line-height: 1.1;
  }
  .vogue__lead {
    margin-top: 24px;
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-2);
  }
  .vogue__sub {
    display: block;
    margin-top: 40px;
    margin-bottom: 16px;
    font-family: inherit;
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .vogue__print .vogue__sub {
    margin-top: 0;
  }
  .vogue__points {
    display: grid;
    gap: 12px;
  }
  .vogue__points li {
    position: relative;
    padding-left: 22px;
    font-size: 17px;
    color: var(--text-2);
  }
  .vogue__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 10px;
    border-top: 1px solid var(--ink);
  }
  .vogue__quote {
    margin-top: 40px;
    padding-left: 24px;
    border-left: 1px solid #d3cabd;
  }
  .vogue__quote p {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(26px, 2.4vw, 32px);
    line-height: 1.3;
  }
  .vogue__quote footer {
    margin-top: 10px;
    font-size: 13px;
    color: var(--muted);
  }
  .vogue__credits {
    display: grid;
    gap: 8px;
    font-size: 16px;
  }
  .vogue__credits div {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }
  .vogue__credits dt {
    min-width: 110px;
    color: var(--muted);
  }
  .vogue__credits a {
    color: var(--ink);
    border-bottom: 1px solid currentColor;
  }
  .vogue__pages {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 899px) {
    .vogue {
      grid-template-columns: 1fr;
    }
  }

  .articles {
    display: grid;
    gap: 40px;
  }
  .article {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    max-width: 760px;
  }
  .article__meta {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .article__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(28px, 2.6vw, 36px);
    line-height: 1.2;
  }
  .article__summary {
    font-size: 17px;
    color: var(--text-2);
  }

  .interviews__intro {
    max-width: 640px;
    margin: -20px 0 44px;
    font-size: 17px;
    color: var(--text-2);
  }
  .interviews__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px 24px;
  }
  /* With JS, only the first 6 (FIRST) show until "Show all" */
  .interviews__grid.is-collapsed [data-extra] {
    display: none;
  }
  .interviews__more {
    display: flex;
    justify-content: center;
    margin-top: 56px;
  }
  .interviews__more[hidden] {
    display: none;
  }
  @media (max-width: 1023px) {
    .interviews__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px 16px;
    }
  }
  @media (max-width: 767px) {
    .interviews__grid {
      grid-template-columns: 1fr;
    }
  }

</style>

<script>
  const list = document.querySelector<HTMLElement>("[data-interviews]");
  const more = document.querySelector<HTMLButtonElement>("[data-interviews-more]");
  if (list && more) {
    list.classList.add("is-collapsed");
    more.parentElement!.hidden = false;
    more.addEventListener("click", () => {
      list.classList.remove("is-collapsed");
      more.parentElement?.remove();
      list.querySelector<HTMLAnchorElement>("[data-extra] a")?.focus();
    });
  }
</script>
